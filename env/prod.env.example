# قيم البناء للإصدار (Production) — مرّرها عبر --dart-define-from-file
# انسخ هذا الملف إلى env/prod.env واملأ القيم الحقيقية.
# لا تُدرج env/prod.env في Git (أضِفه إلى .gitignore).

SUPABASE_URL=https://<your_project_ref>.supabase.co
SUPABASE_ANON_KEY=<your_anon_key>

# معرّف عميل Google للويب (Web client ID) من Google Cloud Console
# → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web client.
# نفس المعرّف المُضاف في Supabase → Authentication → Providers → Google.
# ضروري لظهور «منتقي حسابات Google الأصلي» على Android/iOS بدل المتصفح الخارجي.
GOOGLE_WEB_CLIENT_ID=281392172783-ngr4g28b2c4cap8mvfdav60t9b62pj13.apps.googleusercontent.com
